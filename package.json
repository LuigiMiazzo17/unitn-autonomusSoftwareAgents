  },
  "scripts": {
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "build": "npm run lint && npm run clean && esbuild app.ts --tsconfig=tsconfig.json --bundle --outdir=dist --platform=node --format=esm --external:@unitn-asa/deliveroo-js-client --external:@unitn-asa/pddl-client",
    "start": "npm run build && node --env-file-if-exists=.env dist/app.js"
  },
  "dependencies": {
    "@unitn-asa/deliveroo-js-client": "^2.0.3",
    "queue-typed": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
